---
import '../styles/global.css';
const { title, description, pubDate, heroImage, headings } = Astro.props;

const displayTitle = title || headings?.find((h: any) => h.depth === 1)?.text || "Artículo sin título";
---
<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{displayTitle} | ch00d4</title>
		{description && <meta name="description" content={description} />}
	</head>
	<body>
		<div class="layout">
			<header>
				<a href="/blog" style="font-family: var(--font-mono); font-size: 0.8rem;">← BLOG</a>
				<div style="margin-top: 2rem;">
					<h1>{displayTitle}</h1>
					<p style="opacity: 0.6; font-size: 0.9rem;">{pubDate.toLocaleDateString('es-es', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
				</div>
			</header>

			<main>
				<article class="prose">
					{heroImage && <img width={1020} height={510} src={heroImage} alt="" style="border-radius: 12px; margin-bottom: 2rem;" />}
					<slot />
				</article>
			</main>

			<footer>
				<div class="social">
					<a href="/blog">Blog</a>
					<a href="https://github.com/ch00d4" target="_blank">GitHub</a>
					<a href="https://linkedin.com/in/ch00d4/" target="_blank">LinkedIn</a>
				</div>
			</footer>
		</div>
	</body>
</html>

<style is:global>
	/* Tipografía y estructura base */
	.prose {
		max-width: 100%;
	}
	.prose h1 { display: none; }
	.prose h2 { margin-top: 2.5rem; margin-bottom: 1.25rem; color: var(--title-color); }
	.prose h3 { margin-top: 1.5rem; margin-bottom: 1rem; color: var(--accent-color); }
	.prose p { margin-bottom: 1.5rem; }
	
	/* Enlaces dentro del texto */
	.prose a {
		text-decoration: underline;
		text-underline-offset: 4px;
	}

	/* Listas */
	.prose ul, .prose ol { 
		margin-bottom: 1.5rem; 
		padding-left: 1.5rem; 
	}
	.prose li { margin-bottom: 0.5rem; }

	/* Bloques de Código */
	.prose pre {
		background: var(--deep-night);
		padding: 1.5rem;
		border-radius: 12px;
		overflow-x: auto;
		border: 1px solid var(--border-color);
		margin: 2rem 0;
	}
	.prose code {
		font-family: var(--font-mono);
		font-size: 0.9rem;
		background: var(--subtle);
		padding: 0.2rem 0.4rem;
		border-radius: 4px;
	}
	.prose pre code {
		background: transparent;
		padding: 0;
		color: var(--snow);
	}

	/* Citas */
	.prose blockquote {
		border-left: 4px solid var(--accent-color);
		padding: 0.5rem 0 0.5rem 1.5rem;
		margin: 2rem 0;
		font-style: italic;
		opacity: 0.9;
		background: var(--subtle);
		border-radius: 0 8px 8px 0;
	}

	/* Tablas */
	.prose table {
		width: 100%;
		border-collapse: collapse;
		margin: 2rem 0;
	}
	.prose th, .prose td {
		border: 1px solid var(--border-color);
		padding: 0.75rem;
		text-align: left;
	}
	.prose th {
		background: var(--subtle);
		font-family: var(--font-display);
	}

	/* Imágenes */
	.prose img {
		max-width: 100%;
		height: auto;
		border-radius: 12px;
		margin: 2rem 0;
	}
</style>
