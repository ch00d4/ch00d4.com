---
import '../styles/global.css';
import '../styles/archive.css';
import { getCollection } from 'astro:content';
import fs from 'node:fs';
import path from 'node:path';
import Footer from '../components/Footer.astro';
import Navigation from '../components/Navigation.astro';

const posts = (await getCollection('blog', ({ data }) => {
	return data.draft !== true;
})).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
).slice(0, 3);

// Función para obtener el título del # (H1) o del nombre del archivo
const getDisplayTitle = (post: any) => {
	if (post.data.title) return post.data.title;
	
	try {
		const filePath = path.join(process.cwd(), 'src/content/blog', `${post.id}.md`);
		const content = fs.readFileSync(filePath, 'utf-8');
		const match = content.match(/^#\s+(.+)$/m);
		return match ? match[1] : post.id;
	} catch (e) {
		return post.id;
	}
};
---
<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>Wilfredo González Carvajal</title>
		<!-- Google tag (gtag.js) -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-ZLDC6PNYQE"></script>
		<script is:inline>
		  window.dataLayer = window.dataLayer || [];
		    function gtag(){dataLayer.push(arguments);}
		      gtag('js', new Date());
		      gtag('config', 'G-ZLDC6PNYQE');
		</script>
	</head>
	<body>
		<div class="layout">
			<Navigation />

			<header>
				<img class="avatar" alt="Wilfredo González Carvajal" src="/img/avatar1.png">
				<div>
					<h1>Wilfredo González Carvajal</h1>
					<h2>Developer</h2>
				</div>
				<p>Developer | Project Manager | DevOps</p>
				<p>Especialista en desarrollo backend y liderazgo técnico con enfoque en escalabilidad y arquitectura robusta.</p>
			</header>

			<main>
				<section class="stats">
					<div class="stat-card">
						<b>9</b>
						<p>Años de Experiencia</p>
					</div>
					<div class="stat-card">
						<b>26</b>
						<p>Proyectos Colaborados</p>
					</div>
					<div class="stat-card">
						<b>7</b>
						<p>Proyectos Liderados</p>
					</div>
					<div class="stat-card">
						<b>3</b>
						<p>Proyectos Fundados</p>
					</div>
				</section>

				<section id="blog">
					<h3>Últimos Artículos</h3>
					<br>
					<ul class="post-list">
						{posts.map((post) => (
							<li>
								<a href={`/blog/${post.id}`} class="post-card">
									<h3>{getDisplayTitle(post)}</h3>
									<div class="post-summary-container">
										<p class="post-summary-text">{post.data.description}</p>
									</div>
									<span class="post-date-mono">
										{post.data.pubDate.toLocaleDateString('es-es', { year: 'numeric', month: 'long', day: 'numeric' })}
									</span>
								</a>
							</li>
						))}
					</ul>
					<br>
					<a href="/blog" class="view-all-link">→ Ver todas las publicaciones</a>
				</section>
			</main>

			<Footer />
		</div>
	</body>
</html>
