---
import '../../styles/global.css';
import { getCollection } from 'astro:content';
import type { Page } from 'astro';
import fs from 'node:fs';
import path from 'node:path';

export async function getStaticPaths({ paginate }: { paginate: any }) {
  const allPosts = await getCollection('blog', ({ data }) => {
	return data.draft !== true;
  });
  const sortedPosts = allPosts.sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );
  return paginate(sortedPosts, { pageSize: 10 });
}

const { page } = Astro.props as { page: Page<any> };

// Función para obtener el título del # (H1) o del nombre del archivo
const getDisplayTitle = (post: any) => {
	if (post.data.title) return post.data.title;
	
	try {
		const filePath = path.join(process.cwd(), 'src/content/blog', `${post.id}.md`);
		const content = fs.readFileSync(filePath, 'utf-8');
		const match = content.match(/^#\s+(.+)$/m);
		return match ? match[1] : post.id;
	} catch (e) {
		return post.id;
	}
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Blog - Página {page.currentPage} | ch00d4</title>
	</head>
	<body>
		<div class="layout">
			<header>
				<a href="/" style="font-family: var(--font-mono); font-size: 0.8rem;">← INICIO</a>
				<div style="margin-top: 2rem;">
					<h1>Archivo del Blog</h1>
					<p style="opacity: 0.6;">Explora todas mis publicaciones ({page.total} artículos)</p>
				</div>
			</header>

			<main>
				<ul style="list-style: none; padding: 0; display: flex; flex-direction: column; gap: 1.5rem;">
					{page.data.map((post: any) => (
						<li>
							<article>
								<a href={`/blog/${post.data.slug || post.id}`} style="display: block; border: 1px solid var(--border-color); padding: 1.5rem; border-radius: 12px; background: var(--card-bg);">
									<h3 style="margin-bottom: 0.5rem;">{getDisplayTitle(post)}</h3>
									<p style="font-size: 0.9rem; opacity: 0.8; margin-bottom: 0.5rem;">{post.data.description || "Sin descripción disponible."}</p>
									
									<div class="post-meta">
										<span style="font-family: var(--font-mono); font-size: 0.75rem; opacity: 0.6;">
											{post.data.pubDate.toLocaleDateString('es-es', { year: 'numeric', month: 'long', day: 'numeric' })}
										</span>
									</div>
								</a>
							</article>
						</li>
					))}
				</ul>

				<nav class="pagination">
					{page.url.prev ? <a href={page.url.prev}>← Anterior</a> : <span class="disabled">← Anterior</span>}
					<span class="page-info">Página {page.currentPage} de {page.lastPage}</span>
					{page.url.next ? <a href={page.url.next}>Siguiente →</a> : <span class="disabled">Siguiente →</span>}
				</nav>
			</main>

			<footer>
				<div class="social">
					<a href="/blog">Blog</a>
					<a href="https://github.com/ch00d4" target="_blank">GitHub</a>
					<a href="https://linkedin.com/in/ch00d4/" target="_blank">LinkedIn</a>
					<a href="https://twitter.com/ch00d4" target="_blank">Twitter</a>
				</div>
				<label class="switch-container">
					<span class="switch-label">MODO OSCURO</span>
					<div class="switch">
						<input type="checkbox" id="themeCheckbox">
						<span class="slider"></span>
					</div>
				</label>
			</footer>
		</div>

		<script>
			const checkbox = document.getElementById("themeCheckbox") as HTMLInputElement;
			const element = document.documentElement;

			if (checkbox) {
				checkbox.checked = element.classList.contains("dark");
			}

			checkbox?.addEventListener("change", () => {
			  element.classList.toggle("dark");
			  element.classList.toggle("light");
		
			  const isDark = element.classList.contains("dark");
			  localStorage.setItem("theme", isDark ? "dark" : "light");
			});
		</script>
	</body>
</html>

<style>
	.post-meta {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-top: 1rem;
	}

	.pagination {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-top: 3rem;
		padding-top: 2rem;
		border-top: 1px solid var(--border-color);
		font-family: var(--font-mono);
		font-size: 0.9rem;
	}

	.page-info { opacity: 0.7; }
	.disabled { opacity: 0.3; cursor: not-allowed; }
</style>
