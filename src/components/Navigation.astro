---
interface Props {
  showBack?: boolean;
}

const { showBack = false } = Astro.props;
---
<nav class="main-nav">
  <div class="nav-side-left">
    {showBack && (
      <a href="#" onclick="history.back(); return false;" class="back-btn" aria-label="Volver">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="m15 18-6-6 6-6"/>
        </svg>
      </a>
    )}
  </div>
  <div class="nav-links">
    <a href="/">Inicio</a>
    <a href="/blog">Blog</a>
    <a href="https://drive.google.com/file/d/1-9swsc-_e7h5_RFiiKwYVg32OBQESRZP/view?usp=sharing" target="_blank">CV</a>
  </div>
  <div class="nav-side-right">
    {/* Espacio reservado para mantener el equilibrio del centrado */}
  </div>
</nav>
